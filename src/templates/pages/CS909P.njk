{% extends "layouts/base.njk" %}
{% set title = "교정확인 상세내역" %}
{% block content %}
  <div class="content">
    <button type="button" class="btn-outline --small modalOpen" data-target="#CS909">
      <span>교정확인 상세내역</span>
    </button>
  </div>
  <div class="modal --full --xlarge" id="CS909">
    <div class="modal-wrap">
      <div class="modal-header">
        <h5 class="modal-title">교정확인 상세내역</h5>
      </div>
      <div class="modal-container">
        <section class="content-box">
          <div class="util-wrap --text-type">
            <p class="guide-basic --small">
              주문번호<span>00000000</span>
            </p>
            <p class="guide-basic --small">
              주문일<span>2025.00.00</span>
            </p>
          </div>
          <div class="table-list">
            <div class="list-item-wrap --header">
              <div class="list-item">
                <div class="item --product">
                  <p>주문정보</p>
                </div>
                <div class="item --request-data">
                  <p>검수요청일</p>
                </div>
                <div class="item --confirm-data">
                  <p>고객확인일</p>
                </div>
                <div class="item --manager">
                  <p>담당자</p>
                </div>
                <div class="item --status">
                  <p>상태</p>
                </div>
              </div>
            </div>
            <!-- // list header -->
            <div class="list-item-wrap --body">
              <div class="list-item">
                <div class="item --product" data-label="주문정보">
                  <div class="product-wrap --order-info">
                    <div class="product-inner-item">
                      <div class="product-img"><img src="/resources/fe/images/product/A001_thum_1.jpg" alt="상품이미지"/>
                      </div>
                      <div class="product-info">
                        <p class="product-name">
                          상품명이 나타나게 됩니다. 상품명이 나타나게 됩니다.
                        </p>
                        <div class="product-text">
                          <p class="text">제목명이 나타나게 됩니다. 제목명이 나타나게 됩니다. 제목명이 나타나게 됩니다.</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="item --request-data" data-label="검수요청일">
                  <div class="item-inner">
                    <p class="date">
                      <span>2025-00-00</span>
                      <span>00:00:00</span>
                    </p>
                  </div>
                </div>
                <div class="item --confirm-data" data-label="고객확인일">
                  <div class="item-inner">
                    <p class="date">
                      <span>-</span>
                    </p>
                  </div>
                </div>
                <div class="item --manager" data-label="담당자">
                  <div class="item-inner">
                    <p>담당자</p>
                  </div>
                </div>
                <div class="item --status" data-label="상태">
                  <div class="item-inner">
                    <p class="order-status --ing">검수요청</p>
                    <!-- <p class="order-status --error">인쇄보류</p> <p class="order-status --complete">시안확정</p> -->
                  </div>
                </div>
              </div>
            </div>
            <!-- // list body -->
          </div>
        </section>
        <!-- 시안 확정 전 : 확정 후 미사용 -->
        <section class="content-box">
          <div class="title-wrap">
            <h5>파일재접수</h5>
          </div>
          <!-- 파일재접수 전 -->
          <div class="table-list">
            <div class="list-item-wrap --header">
              <div class="list-item">
                <div class="item --re-sub-file">
                  <p>구분</p>
                </div>
                <div class="item --re-sub-file">
                  <p>기존파일</p>
                </div>
                <div class="item --re-sub">
                  <p>재접수 정보</p>
                </div>
              </div>
            </div>
            <!-- // list header -->
            <div class="list-item-wrap --body">
              <div class="list-item">
                <div class="item --re-sub-file" data-label="구분">
                  <div class="item-inner">
                    <p>내지</P>
                  </div>
                </div>
                <div class="item --re-sub-file" data-label="기존파일">
                  <div class="item-inner">
                    <p class="guide-basic">파일명.pdf</p>
                    <p class="date">
                      <span>2025-00-00 00:00:00</span>
                    </p>
                  </div>
                </div>
                <div class="item --re-sub --add-file" data-label="재접수 정보">
                  <div class="form-wrap">
                    <div class="form-field">
                      <div class="form-wrap file">
                        <label class="btn-primary --small">
                          <input type="file"/>
                          <span>파일첨부</span>
                        </label>
                        <span class="guide-sub">선택한 파일이 없습니다.</span>
                        <!-- // 파일 선택 후 : 안내문구 > 파일명으로 텍스트 대치 -->
                        <!-- 파일 선택 후 : 삭제 버튼 사용 -->
                        <button type="button" class="btn-del">
                          <i class="delete">삭제</i>
                        </button>
                        <!-- // 파일 선택 후 : 삭제 버튼 사용 -->
                      </div>
                    </div>
                    <div class="form-field textarea">
                      <div class="form-wrap">
                        <textarea id="textarea" placeholder="상품에 대한 요청사항을 자세히 작성해주세요."></textarea>
                      </div>
                      <div class="textarea-bottom">
                        <div class="count">
                          <em>1</em>/<span>100</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- // list body -->
          </div>
          <!-- // 파일재접수 전 -->
          <!-- 파일재접수 후 -->
          <div class="table-list">
            <div class="list-item-wrap --header">
              <div class="list-item">
                <div class="item --re-sub-file">
                  <p>구분</p>
                </div>
                <div class="item --re-sub-file">
                  <p>재접수 파일</p>
                </div>
                <div class="item --re-sub">
                  <p>전달사항</p>
                </div>
              </div>
            </div>
            <!-- // list header -->
            <div class="list-item-wrap --body">
              <div class="list-item">
                <div class="item --re-sub-file" data-label="구분">
                  <div class="item-inner">
                    <p>내지</P>
                  </div>
                </div>
                <div class="item --re-sub-file" data-label="재접수 파일">
                  <div class="item-inner">
                    <p class="guide-basic">파일명.pdf</p>
                    <p class="date">
                      <span>2025-00-00 00:00:00</span>
                    </p>
                  </div>
                </div>
                <div class="item --re-sub" data-label="전달사항">
                  <div class="item-inner">
                    <div class="guide-basic">
                      <p>A3사이즈로 재조정해서 파일 접수합니다. 교정 확인 후 얼마나 걸리는지 안내 부탁드립니다.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- // list body -->
          </div>
          <!-- // 파일재접수 후 -->
          <p class="guide-sub --small">*시안확정 시 입력하신 ‘전달사항’은 전달되지 않습니다.</p>
        </section>
        <!-- // 시안 확정 전 : 확정 후 미사용 -->
      </div>
      <div class="modal-footer">
        <div class="btn-wrap confirm">
          <button type="button" class="btn-primary --medium --default">
            <span>시안확정</span>
          </button>
          <button type="button" class="btn-black --medium --default">
            <span>파일재접수</span>
          </button>
          <button type="button" class="btn-outline --medium">
            <span>닫기</span>
          </button>
        </div>
      </div>
      <div class="btn-wrap close">
        <button type="button" class="btn-close modalClose">
          <i>닫기</i>
        </button>
      </div>
    </div>
  </div>
{% endblock %}