{% extends "layouts/base.njk" %}
{% set title = "비회원 주문조회" %}
{% block content %}
  <div class="content">
    <div class="login-wrap">
      <div class="page-title">
        <h3>비회원 주문조회</h3>
        <p class="guide-sub-deep">주문시 입력했던 휴대전화 번호로<br/>주문상품과 배송 정보를 확인하실 수 있습니다.</p>
      </div>
      <section class="content-box">
        <div class="form-field">
          <div class="form-inner button-option">
            <input type="tel" placeholder="휴대폰번호"/>
            <button type="button" class="btn-black --small">
              <span>인증번호 발송</span>
            </button>
          </div>
          <!-- 인증번호 입력 -->
          <div class="form-inner button-option">
            <div class="form-wrap">
              <input type="text" placeholder="인증번호 숫자 입력"/>
              <span class="time">2:00</span>
            </div>
            <button type="button" class="btn-primary --small">
              <span>인증하기</span>
            </button>
          </div>
          <!-- 비회원 인증 완료 -->
          <div class="inner-wrap">
            <p class="guide-basic">
              <span class="icon-check"></span>인증 완료되었습니다.
            </p>
          </div>
        </div>
        <div class="btn-wrap confirm">
          <button type="button" class="btn-black --medium">
            <span>주문조회</span>
          </button>
        </div>
      </section>
      <div class="btn-wrap confirm">
        <button type="button" class="btn-primary --medium">
          <span>회원가입</span>
        </button>
      </div>
    </div>
  </div>
{% endblock %}