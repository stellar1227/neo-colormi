{% extends "layouts/base.njk" %}
{% set title = "상세보기" %}
{% block content %}
  <div class="content">
    <button type="button" class="btn-outline --small modalOpen" data-target="#PD500">
      <span>상세보기</span>
    </button>
  </div>
  <div class="modal --full --xlarge" id="PD500">
    <div class="modal-wrap">
      <div class="modal-header">
        <h5 class="modal-title">상세보기</h5>
      </div>
      <div class="modal-container">
        <div class="comment-view">
          <img src="comment_1.jpg" alt="상세보기 이미지"/>
        </div>
      </div>
      <div class="modal-footer">
        <div class="btn-wrap confirm">
          <button type="button" class="btn-outline --medium modalClose">
            <span>닫기</span>
          </button>
        </div>
      </div>
      <div class="btn-wrap close">
        <button type="button" class="btn-close modalClose">
          <i>닫기</i>
        </button>
      </div>
    </div>
  </div>
{% endblock %}